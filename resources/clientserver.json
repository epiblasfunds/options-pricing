{
  "api": {
    "base_url": "http://127.0.0.1:8000",
    "timeout_seconds": 300,
    "cache_entries": 1
  },
  "model_storage": {
    "backend": "local",
    "local_cache_dir": "artifacts/api_model_cache",
    "local": {
      "trained_models_dir": "src/volatility_models/trained_models",
      "retrained_metadata_dir": "src/volatility_models/trained_metadata/retrained_metadata",
      "dashboard_models_dir": "src/dashboard/saved_models"
    },
    "gcp": {
      "credentials_path": null,
      "trained_models_bucket": null,
      "trained_models_prefix": "trained_models",
      "retrained_metadata_bucket": null,
      "retrained_metadata_prefix": "trained_metadata",
      "explainability_artifacts_bucket": null,
      "dashboard_models_prefix": ""
    }
  },
  "dashboard": {
    "model_storage_dir": "src/dashboard/saved_models",
    "manual_input_features": [
      "OptionType",
      "StrikePrice",
      "UnderlyingPrice",
      "TimeToExpiration",
