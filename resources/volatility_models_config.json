{
    "training_data_config": {
        "vol_db_cols": [
            "ExecDatetime",
            "OptionContractCode",
            "OptionType",
            "StrikePrice",
            "UnderlyingPrice",
            "TimeToExpiration",
            "Rate",
            "ImpliedVolatility"
        ],
        "aux_context_cols": [
            "ExecDatetime",
            "OptionContractCode"
        ],
        "raw_model_input": [
            "OptionType",
            "StrikePrice",
            "UnderlyingPrice",
            "TimeToExpiration",
            "Rate"
        ],
        "numeric_features": [
            "TTEYears",
            "sqrtTTEYears",
            "logMoneyness",
            "logMoneynessSq",
            "logMoneynessXSqrtTTE",
            "logForwardMoneyness",
            "rate"
        ],
        "target_column": "ImpliedVolatility",
        "train_test_split_config": {
            "train_size": 0.85,
            "lag": 15
        },
        "kfolds_config": {
            "n_folds": 5,
            "extra_blocks": 2
        },
        "custom_error_1": {
            "metric": "custom_error1",
            "mode": "min",
            "alpha": 0.25,
            "beta": 0.75,
            "base_metric": "rmse"
        },
        "custom_error_2": {
            "metric": "custom_error2",
            "mode": "min",
            "gamma": 0.25,
            "beta": 0.75,
            "base_metric": "rmse"
        },
        "models_metrics": [
            "mae",
            "rmse",
            "r2"
        ],
        "required_scaler_models": [
            "sequential_nn",
            "quantum_inspired_nn"
        ],
        "progressive_training_config": {
            "n_segments": 5,
            "moneyness_column": "logMoneyness"
        }
    }
}